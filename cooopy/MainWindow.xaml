<Window x:Class="Cooopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cooopy" Icon="cooopy.ico"
        Width="1000" Height="660"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBg}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14.5"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <DataTemplate x:Key="RecordBubbleTemplate">
            <Grid x:Name="BubbleRoot" Margin="14,8,16,9"
                  UseLayoutRounding="True" SnapsToDevicePixels="True">
                <!-- separate shadow layers keep text crisp -->
                <!-- 环境阴影：四周均匀扩散，保证卡片上方也有一圈淡淡的阴影。
                     注意：这两个阴影层只是「用来投影的假卡片」，本身是纯白 Surface。
                     它们必须比 CardBorder 内缩 1px（圆角 12 -> 11，保持同心），
                     否则纯白底会在卡片 1px 描边的抗锯齿边缘漏出一条白缝。 -->
                <Border x:Name="GlowBorder" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="11" Margin="1" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.09" Direction="0" />
                    </Border.Effect>
                </Border>

                <!-- 方向阴影：向下投，制造卡片浮起的感觉（同样内缩 1px） -->
                <Border x:Name="ShadowBorder" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="11" Margin="1" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270" />
                    </Border.Effect>
                </Border>

                <Border x:Name="CardBorder" Background="{StaticResource Surface}" CornerRadius="12"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,12">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel x:Name="BubbleActions" DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource RowIcon}" Tag="{Binding}"
                                        Click="RecordEdit_Click" ToolTip="展开编辑 / 收起">
                                    <Grid Width="12" Height="12">
                                        <Path x:Name="EditDownIcon" Data="M 2.5 4 L 8 9.5 L 13.5 4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Stretch="Uniform" />
                                        <Path x:Name="EditUpIcon" Data="M 2.5 9.5 L 8 4 L 13.5 9.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Stretch="Uniform"
                                              Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowIconDanger}" Tag="{Binding}"
                                        Click="RecordDelete_Click" ToolTip="删除 / 保存">
                                    <Grid Width="12" Height="12">
                                        <Path x:Name="DeleteXIcon" Data="M 4 4 L 12 12 M 12 4 L 4 12"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.3" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" Width="10" Height="10"
                                              Stretch="Uniform" />
                                        <Path x:Name="DeleteCheckIcon" Data="M 2.8 8.4 L 6.2 11.6 L 13.2 3.6"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Stretch="Uniform"
                                              Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 紧急程度：红/黄/绿纯色小球 -->
                                <Ellipse Width="9" Height="9" Fill="{Binding UrgencyBrush}"
                                         Visibility="{Binding UrgencyVisibility}"
                                         Margin="0,0,7,0" VerticalAlignment="Center" />
                                <!-- 置顶标记 -->
                                <Path Data="{StaticResource PinGlyph}"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                      Fill="Transparent" Width="11" Height="11"
                                      Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Visibility="{Binding PinVisibility}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <!-- 私密标记：眼睛带斜杠 -->
                                <Path Data="{StaticResource EyeOffGlyph}"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4"
                                      Fill="Transparent" Width="11" Height="11"
                                      Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Visibility="{Binding LockVisibility}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <TextBlock Text="{Binding TimeText}" FontSize="12.5"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 收起 / 展开都由 TextBox 渲染（同一字体度量引擎），文字渲染、换行位置、
                             左右内边距完全一致；展开只是换成可编辑的那个 TextBox，并把可见行数从 3 行放大到 5 行。
                             上边距 9 = 8 + 1，用来还原原先 20px 行高带来的 1px 上方行距 -->
                        <Border x:Name="TextFrame" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="10,9,10,8" Margin="0,8,0,0"
                                Background="{StaticResource Surface}" ClipToBounds="True">
                            <Grid>
                                <!-- 收起：最大 3 行（55.3 = 3 × 18.42），只读、不接收鼠标/焦点，滚轮仍归列表 -->
                                <TextBox x:Name="BubbleTextView" Text="{Binding DisplayText}"
                                         Style="{StaticResource Input}" BorderThickness="0"
                                         Background="Transparent" Padding="0" MinHeight="0" MaxHeight="55.3"
                                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="14.5"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Hidden"
                                         IsReadOnly="True" IsHitTestVisible="False"
                                         Focusable="False" IsTabStop="False" />

                                <!-- 展开：可编辑，最大 5 行（92.2 = 5 × 18.42），超出后显示悬浮滚动条 -->
                                <TextBox x:Name="EditTextBox" Visibility="Collapsed"
                                         Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BubbleEditInput}" BorderThickness="0"
                                         Background="Transparent" Padding="0" MinHeight="0" MaxHeight="92.2"
                                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="14.5"
                                         VerticalContentAlignment="Top"
                                         PreviewMouseWheel="EditTextBox_PreviewMouseWheel" />
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="ViewTagList" ItemsSource="{Binding Tags}" Margin="0,10,0,0"
                                      ItemTemplate="{StaticResource TagChipTemplate}"
                                      PreviewMouseLeftButtonUp="RecordTags_Click">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 标签胶囊自带 8px 下外边距（用于换行时的行间距），这里抵掉最后一行的那 8px，
                             保证展开态「标签到卡片下边框」的距离与收起态完全一致 -->
                        <ItemsControl x:Name="EditTagList" ItemsSource="{Binding EditTags}" Margin="0,10,0,-8"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,6,8" Cursor="Hand" Height="25"
                                          ToolTip="{Binding Tag.Name}"
                                          MouseLeftButtonUp="ToggleEditTag_Click">
                                        <!-- 自定义标签 -->
                                        <Border x:Name="ChipOff" Background="Transparent"
                                                BorderBrush="{Binding Tag.DotBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="9,0">
                                            <TextBlock Text="{Binding Tag.Name}" VerticalAlignment="Center"
                                                       Foreground="{Binding Tag.DotBrush}" FontSize="13" />
                                        </Border>
                                        <Border x:Name="ChipOn" Background="{Binding Tag.ChipBackground}"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="8" Padding="9,0" Visibility="Collapsed">
                                            <TextBlock Text="{Binding Tag.Name}" VerticalAlignment="Center"
                                                       Foreground="{Binding Tag.ChipForeground}" FontSize="13" />
                                        </Border>

                                        <!-- 默认标签：紧急程度实际颜色小球（未选中空心，选中实心） -->
                                        <Grid x:Name="UrgencyRoot" Width="25" Height="25" Visibility="Collapsed">
                                            <Ellipse x:Name="UrgencyRing" Fill="{StaticResource Surface}"
                                                     Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.2" />
                                            <Ellipse x:Name="UrgencySolid" Fill="{Binding Tag.DotBrush}"
                                                     Visibility="Collapsed" />
                                        </Grid>

                                        <!-- 默认标签：置顶小球（横线上箭头） -->
                                        <Grid x:Name="PinRoot" Width="25" Height="25" Visibility="Collapsed">
                                            <Ellipse x:Name="PinRing" Fill="{StaticResource Surface}"
                                                     Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.2" />
                                            <Path x:Name="PinIcon" Data="{StaticResource PinGlyph}"
                                                  Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.5"
                                                  Fill="Transparent" Width="14" Height="14"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Grid>

                                        <!-- 默认标签：私密小球（眼睛带斜杠） -->
                                        <Grid x:Name="PrivateRoot" Width="25" Height="25" Visibility="Collapsed">
                                            <Ellipse x:Name="PrivateRing" Fill="{StaticResource Surface}"
                                                     Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.2" />
                                            <Path x:Name="PrivateIcon" Data="{StaticResource EyeOffGlyph}"
                                                  Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.4"
                                                  Fill="Transparent" Width="14" Height="14"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag.Kind}" Value="urgency">
                                            <Setter TargetName="ChipOff" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ChipOn" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="UrgencyRoot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag.Kind}" Value="pin">
                                            <Setter TargetName="ChipOff" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ChipOn" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="PinRoot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag.Kind}" Value="private">
                                            <Setter TargetName="ChipOff" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ChipOn" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="PrivateRoot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding Tag.Kind}" Value="urgency" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="UrgencyRing" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="UrgencySolid" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding Tag.Kind}" Value="pin" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="PinRing" Property="Fill" Value="{StaticResource Accent}" />
                                            <Setter TargetName="PinRing" Property="Stroke" Value="{StaticResource Accent}" />
                                            <Setter TargetName="PinIcon" Property="Stroke" Value="White" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding Tag.Kind}" Value="private" />
                                            </MultiDataTrigger.Conditions>
                                            <!-- 私密选中后的配色与置顶一致：Accent 实心 + 白色图标 -->
                                            <Setter TargetName="PrivateRing" Property="Fill" Value="{StaticResource Accent}" />
                                            <Setter TargetName="PrivateRing" Property="Stroke" Value="{StaticResource Accent}" />
                                            <Setter TargetName="PrivateIcon" Property="Stroke" Value="White" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                <Condition Binding="{Binding Tag.Kind}" Value="" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ChipOff" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ChipOn" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="BubbleTextView" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditTextBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ViewTagList" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditTagList" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EditDownIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditUpIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DeleteXIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DeleteCheckIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BubbleRoot" Property="Panel.ZIndex" Value="1" />
                    <Setter TargetName="GlowBorder" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.16" Direction="0" />
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="ShadowBorder" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.24" Direction="270" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
<DataTemplate x:Key="RecordTemplate">
            <Border x:Name="RowBorder" Background="Transparent"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Padding="18,0" Height="48" ClipToBounds="True"
                    MouseRightButtonUp="RecordRow_RightClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding UrgencyBrush}"
                                 Visibility="{Binding UrgencyVisibility}"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Path DockPanel.Dock="Left" Data="{StaticResource PinGlyph}"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.6" Fill="Transparent"
                              Width="10" Height="10" Stretch="Uniform" Margin="0,0,8,0"
                              VerticalAlignment="Center" Visibility="{Binding PinVisibility}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <!-- 私密标记：眼睛带斜杠 -->
                        <Path DockPanel.Dock="Left" Data="{StaticResource EyeOffGlyph}"
                              Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4" Fill="Transparent"
                              Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0"
                              VerticalAlignment="Center" Visibility="{Binding LockVisibility}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{Binding Preview}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" FontSize="14.5"
                                   Foreground="{StaticResource TextPrimary}" />
                    </DockPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Tags}"
                                      ItemTemplate="{StaticResource TagChipTemplate}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      PreviewMouseLeftButtonUp="RecordTags_Click">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Button Style="{StaticResource RowIcon}" Tag="{Binding}"
                                Click="RecordEdit_Click" ToolTip="编辑">
                            <StackPanel Orientation="Horizontal" Height="22" VerticalAlignment="Center">
                                <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="2.5,0" />
                                <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowIconDanger}" Tag="{Binding}"
                                Click="RecordDelete_Click" ToolTip="删除（Shift+点击直接删除）">
                            <Path Data="M 4 4 L 12 12 M 12 4 L 4 12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SurfaceAlt}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TagRowTemplate">
            <Border x:Name="TagRowBorder" Background="Transparent"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Padding="18,0" Height="48">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{Binding Tag.ChipBackground}" CornerRadius="8"
                                Height="24" Padding="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tag.Name}" FontSize="14"
                                       Foreground="{Binding Tag.ChipForeground}" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding CountText}" FontSize="13"
                                   Foreground="{StaticResource TextMuted}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowIcon}" Tag="{Binding}"
                                Click="TagEdit_Click" ToolTip="编辑">
                            <StackPanel Orientation="Horizontal" Height="22" VerticalAlignment="Center">
                                <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="2.5,0" />
                                <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowIconDanger}" Tag="{Binding}"
                                Click="TagDelete_Click" ToolTip="删除（Shift+点击直接删除）">
                            <Path Data="M 4 4 L 12 12 M 12 4 L 4 12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="TagRowBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TagRowBorder" Property="Background" Value="{StaticResource SurfaceAlt}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 默认标签：竖向一行一个，和自定义标签同高的小球（置顶符号 / 红黄绿实际颜色） -->
        <DataTemplate x:Key="DefaultTagRowTemplate">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Padding="18,0" Height="48">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{Binding Tag.Name}">
                    <Grid Width="25" Height="25" VerticalAlignment="Center">
                        <!-- 紧急程度：实际颜色小球 -->
                        <Ellipse x:Name="UrgencyBall" Fill="{Binding Tag.DotBrush}" Visibility="Collapsed" />
                        <!-- 置顶符号小球 -->
                        <Ellipse x:Name="PinRing" Fill="{StaticResource Surface}"
                                 Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.2" Visibility="Collapsed" />
                        <Path x:Name="PinIcon" Data="{StaticResource PinGlyph}"
                              Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.5" Fill="Transparent"
                              Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <!-- 私密：眼睛带斜杠的小球 -->
                        <Ellipse x:Name="PrivateRing" Fill="{StaticResource Surface}"
                                 Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.2" Visibility="Collapsed" />
                        <Path x:Name="PrivateIcon" Data="{StaticResource EyeOffGlyph}"
                              Stroke="{Binding Tag.DotBrush}" StrokeThickness="1.4" Fill="Transparent"
                              Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                    <TextBlock Text="{Binding CountText}" FontSize="13"
                               Foreground="{StaticResource TextMuted}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tag.Kind}" Value="urgency">
                    <Setter TargetName="UrgencyBall" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag.Kind}" Value="pin">
                    <Setter TargetName="PinRing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PinIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag.Kind}" Value="private">
                    <Setter TargetName="PrivateRing" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PrivateIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource AppBg}"
            BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= title bar ================= -->
        <Grid Grid.Row="0" Background="{StaticResource Surface}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="AppLogo" Grid.Column="0" Text="cooopy" FontSize="17.5" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                       Margin="16,0,0,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="20,0,0,0">
                <RadioButton x:Name="NavRecords" Style="{StaticResource TopTab}"
                             IsChecked="True" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="NavRecordsIcon"
                              Data="M 3.2 9.8 L 10.6 2.4 L 13.4 5.2 L 6 12.6 H 3.2 Z M 2.2 14.6 H 14.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Visibility="Collapsed" />
                        <TextBlock x:Name="NavRecordsText" Text="记录" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTags" Style="{StaticResource TopTab}"
                             Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="NavTagsIcon"
                              Data="M 2.6 3 H 8.6 L 13.2 7.6 L 8.6 12.2 H 2.6 Z M 5.2 7.6 A 1.1 1.1 0 1 0 7.4 7.6 A 1.1 1.1 0 1 0 5.2 7.6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Visibility="Collapsed" />
                        <TextBlock x:Name="NavTagsText" Text="标签" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAdvanced" Style="{StaticResource TopTab}" Content="高级"
                             Visibility="Collapsed" Checked="Nav_Checked" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource TopTab}"
                             Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="NavSettingsIcon"
                              Data="M 19.4 15 A 1.65 1.65 0 0 0 19.73 16.82 L 19.79 16.88 A 2 2 0 0 1 19.79 19.71 A 2 2 0 0 1 16.96 19.71 L 16.9 19.65 A 1.65 1.65 0 0 0 15.08 19.32 A 1.65 1.65 0 0 0 14.08 20.83 V 21 A 2 2 0 0 1 12.08 23 A 2 2 0 0 1 10.08 21 V 20.91 A 1.65 1.65 0 0 0 9.08 19.4 A 1.65 1.65 0 0 0 7.26 19.73 L 7.2 19.79 A 2 2 0 0 1 4.37 19.79 A 2 2 0 0 1 4.37 16.96 L 4.43 16.9 A 1.65 1.65 0 0 0 4.76 15.08 A 1.65 1.65 0 0 0 3.25 14.08 H 3 A 2 2 0 0 1 1 12.08 A 2 2 0 0 1 3 10.08 H 3.09 A 1.65 1.65 0 0 0 4.6 9.08 A 1.65 1.65 0 0 0 4.27 7.26 L 4.21 7.2 A 2 2 0 0 1 4.21 4.37 A 2 2 0 0 1 7.04 4.37 L 7.1 4.43 A 1.65 1.65 0 0 0 8.92 4.76 H 9 A 1.65 1.65 0 0 0 10 3.25 V 3 A 2 2 0 0 1 12 1 A 2 2 0 0 1 14 3 V 3.09 A 1.65 1.65 0 0 0 15 4.6 A 1.65 1.65 0 0 0 16.82 4.27 L 16.88 4.21 A 2 2 0 0 1 19.71 4.21 A 2 2 0 0 1 19.71 7.04 L 19.65 7.1 A 1.65 1.65 0 0 0 19.32 8.92 V 9 A 1.65 1.65 0 0 0 20.83 10 H 21 A 2 2 0 0 1 23 12 A 2 2 0 0 1 21 14 H 20.91 A 1.65 1.65 0 0 0 19.4 15 Z M 15 12 A 3 3 0 1 0 9 12 A 3 3 0 1 0 15 12 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.2" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Visibility="Collapsed" />
                        <TextBlock x:Name="NavSettingsText" Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <Border x:Name="PauseBadge" Background="#FFF2CC" CornerRadius="6" Padding="8,2"
                        Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="PauseText" Text="记录已暂停" FontSize="12.5" Foreground="#8A5B00" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <Button x:Name="TopMostButton" Style="{StaticResource WindowButton}"
                        Click="TopMostButton_Click" ToolTip="窗口置顶">
                    <Path Data="{StaticResource PushpinGlyph}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="MinButton_Click" ToolTip="最小化">
                    <Path Data="M 2 7 H 12" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}"
                        Click="MaxButton_Click" ToolTip="最大化">
                    <Path x:Name="MaxIcon" Data="M 2 2 H 12 V 12 H 2 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="关闭">
                    <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= content ================= -->
        <Grid Grid.Row="1">

            <!-- records -->
            <DockPanel x:Name="RecordsPanel">
                <Border DockPanel.Dock="Top" Margin="18,14,18,6">
                    <Grid x:Name="ToolbarGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SearchGrid" Grid.Row="0" Grid.Column="0" Height="36">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" AutomationProperties.Name="搜索"
                                     FontSize="15.5" Padding="5,3" TextChanged="SearchBox_TextChanged"
                                     GotKeyboardFocus="SearchBox_GotFocus" LostKeyboardFocus="SearchBox_LostFocus" />
                            <TextBlock x:Name="SearchPlaceholder" Text="搜索文本或标签…"
                                       Foreground="{StaticResource TextMuted}" FontSize="15.5"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Button Grid.Column="1" x:Name="FilterButton" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Height="36" Padding="10,6"
                                Click="FilterButton_Click" ToolTip="标签筛选（可多选）">
                            <Path Data="M 2 3.2 H 14 L 9.2 8.8 V 12.9 L 6.8 14.2 V 8.8 Z"
                                  Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"
                                  Fill="Transparent" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Grid.Column="2" x:Name="SortButton" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Height="36" Padding="10,6"
                                Click="SortButton_Click">
                            <Grid Width="12" Height="12">
                                <Path x:Name="SortDescIcon"
                                      Data="M 3 3 L 8 8 L 13 3 M 3 8 L 8 13 L 13 8"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3"
                                      Fill="Transparent" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                                <Path x:Name="SortAscIcon"
                                      Data="M 3 9 L 8 4 L 13 9 M 3 14 L 8 9 L 13 14"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3"
                                      Fill="Transparent" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="3" x:Name="HideUntaggedButton" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Height="36" Padding="10,6"
                                Click="ToggleHideUntagged_Click" ToolTip="显示/隐藏无标签记录">
                            <Grid Width="16" Height="16">
                                <Path x:Name="EyeOpenIcon"
                                      Data="M 1.5 8 C 3.5 4.6 5.7 3.4 8 3.4 C 10.3 3.4 12.5 4.6 14.5 8 C 12.5 11.4 10.3 12.6 8 12.6 C 5.7 12.6 3.5 11.4 1.5 8 Z M 8 5.7 A 2.3 2.3 0 1 1 8 10.3 A 2.3 2.3 0 1 1 8 5.7"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"
                                      Fill="Transparent" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                                <Path x:Name="EyeClosedIcon"
                                      Data="M 1.5 8 C 3.5 10.6 5.7 11.6 8 11.6 C 10.3 11.6 12.5 10.6 14.5 8 M 3.3 10.1 L 2.2 12.1 M 8 11.6 V 13.7 M 12.7 10.1 L 13.8 12.1"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"
                                      Fill="Transparent" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="4" x:Name="ClearUntaggedButton" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Height="36" Padding="10,6"
                                Click="ClearUntagged_Click" ToolTip="清除所有无标签记录">
                            <Path Data="M 2.5 4.2 H 13.5 M 5.6 4.2 V 2.5 H 10.4 V 4.2 M 4.2 4.2 L 4.9 13.8 H 11.1 L 11.8 4.2 M 6.3 6.4 V 11.4 M 9.7 6.4 V 11.4"
                                  Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <Grid>
                    <ListBox x:Name="RecordsList"
                             Margin="0,0,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource RecordItemContainer}"
                             ItemTemplate="{StaticResource RecordTemplate}">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource ReservedScrollViewer}" />
                        </ListBox.Resources>
                    </ListBox>

                    <ListBox x:Name="RecordsBubbleList" Visibility="Collapsed"
                             Margin="4,0,0,10"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemTemplate="{StaticResource RecordBubbleTemplate}"
                             ItemContainerStyle="{StaticResource RecordBubbleItemContainer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Style="{StaticResource ReservedScrollViewer}"
                                              CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              ScrollChanged="BubbleScroll_ScrollChanged">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <StackPanel x:Name="RecordsEmpty" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                Margin="0,0,0,60">
                        <TextBlock Text="还没有记录" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="复制一段文字试试，cooopy 会自动收进来"
                                   FontSize="14.5" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- tags -->
            <DockPanel x:Name="TagsPanel" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource ReservedScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 默认标签：标题行 -->
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                Padding="18,0" Height="48">
                            <TextBlock Text="默认标签" FontSize="13.5" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                        </Border>

                        <ItemsControl x:Name="DefaultTagsList" ItemTemplate="{StaticResource DefaultTagRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 自定义标签：标题行 + 新建按钮 -->
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                Padding="18,0" Height="48">
                            <DockPanel VerticalAlignment="Center">
                                <Button Content="＋ 新建标签" Style="{StaticResource GhostButton}"
                                        Height="32" Padding="12,4" DockPanel.Dock="Right"
                                        Click="TagCreate_Click" />
                                <TextBlock Text="自定义标签" FontSize="13.5" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <ItemsControl x:Name="TagsList" ItemTemplate="{StaticResource TagRowTemplate}" />

                        <StackPanel x:Name="TagsEmpty" Visibility="Collapsed" Margin="18,26,18,60">
                            <TextBlock Text="还没有自定义标签" FontSize="16.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="点击右上角「新建标签」创建，之后就能按标签快速筛选"
                                       FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- advanced (DeepSeek AI import) -->
            <Grid x:Name="AdvancedPanel" Visibility="Collapsed">
                <Grid x:Name="AdvancedEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="高级 AI 导入" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="需要先填写 DeepSeek API 地址和密钥" FontSize="14.5"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <Button Content="去设置填写" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Margin="0,18,0,0" Click="AdvancedGoSettings_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="AdvancedChat" Visibility="Collapsed" Margin="18,12,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="清空对话" Style="{StaticResource GhostButton}"
                                DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0"
                                Click="ClearChat_Click" />
                        <StackPanel>
                            <TextBlock Text="AI 导入助手" FontSize="16.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="把网上的链接、列表或大段文字发给它，整理成记录并自动导入"
                                       FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="10">
                        <ScrollViewer x:Name="ChatScroll" Style="{StaticResource ReservedScrollViewer}" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatMessages" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Style="{StaticResource Input}"
                                 Grid.Column="0" MinHeight="66" MaxHeight="140"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 FontSize="14" Padding="8,6" PreviewKeyDown="ChatInput_PreviewKeyDown" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                            <Button Content="从剪贴板填入" Style="{StaticResource GhostButton}"
                                    Padding="10,5" Margin="0,0,0,8" Click="FillClipboard_Click" />
                            <Button x:Name="ChatSendButton" Content="发送" Style="{StaticResource PrimaryButton}"
                                    Padding="16,6" Click="SendChat_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- settings -->
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"
                          Style="{StaticResource ReservedScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsContent" Margin="22,18,22,30" MaxWidth="740" HorizontalAlignment="Center">

                    <!-- general -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="常规" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeNoteRadio" Style="{StaticResource OptionRadio}"
                                             Content="笔记模式" GroupName="uiMode" Checked="ModeRadio_Checked" />
                                <RadioButton x:Name="ModeBubbleRadio" Style="{StaticResource OptionRadio}"
                                             Content="卡片模式" GroupName="uiMode" Margin="28,5,0,5"
                                             Checked="ModeRadio_Checked" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,6,0,4" />

                            <CheckBox x:Name="ChkAutoStart" Content="开机自动启动"
                                      Checked="SettingsChanged_Click" Unchecked="SettingsChanged_Click" />
                            <CheckBox x:Name="ChkCloseToTray" Content="关闭窗口时最小化到托盘"
                                      Checked="SettingsChanged_Click" Unchecked="SettingsChanged_Click" />
                            <CheckBox x:Name="ChkStartMinimized" Content="手动启动时隐藏主窗口"
                                      Checked="SettingsChanged_Click" Unchecked="SettingsChanged_Click" />
                            <CheckBox x:Name="ChkQuickAutoSave" Content="点击cooopy剪贴板外，自动关闭并保存"
                                      Checked="SettingsChanged_Click" Unchecked="SettingsChanged_Click" />
                            <CheckBox x:Name="ChkAutoCapture" Content="持续监控剪贴板*"
                                      Checked="SettingsChanged_Click" Unchecked="SettingsChanged_Click" />
                            <CheckBox x:Name="ChkMaskIdCards" Content="给身份证 / 银行卡打码破坏后入库"
                                      Checked="SettingsChanged_Click" Unchecked="SettingsChanged_Click"
                                      ToolTip="复制含证件号的内容时自动打码：身份证保留前 6 后 4（110105********002X），银行卡保留前 4 后 4。勾了「私密」标签的记录按原文保存" />
                        </StackPanel>
                    </Border>

                    <!-- hotkeys -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="快捷键" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="在下方输入自定义组合键。以 Ctrl / Shift / Alt 开头，不支持 Win 键。"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />

                            <CheckBox x:Name="ChkHotkeyMainEnabled" Content="显示 / 隐藏主界面"
                                      Margin="0,4,0,4" VerticalAlignment="Center"
                                      Checked="HotkeyEnabled_Changed"
                                      Unchecked="HotkeyEnabled_Changed" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeyMainBox" Style="{StaticResource Input}" Width="220"
                                         AutomationProperties.Name="主界面快捷键"
                                         IsReadOnly="True" Cursor="Hand"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus" />
                                <Button x:Name="HotkeyMainResetButton"
                                        Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0"
                                        Margin="8,0,0,0" Click="HotkeyMainReset_Click"
                                        ToolTip="恢复默认快捷键（Ctrl+Alt+C）">
                                    <TextBlock Text="↺" FontFamily="Segoe UI Symbol" FontSize="19"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Button>
                            </StackPanel>

                            <CheckBox x:Name="ChkHotkeySaveEnabled" Content="cooopy剪贴板指令"
                                      Margin="0,12,0,4" VerticalAlignment="Center"
                                      Checked="HotkeyEnabled_Changed"
                                      Unchecked="HotkeyEnabled_Changed" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HotkeySaveBox" Style="{StaticResource Input}" Width="220"
                                         AutomationProperties.Name="快速打标快捷键"
                                         IsReadOnly="True" Cursor="Hand"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotFocus="HotkeyBox_GotFocus"
                                         LostFocus="HotkeyBox_LostFocus" />
                                <Button x:Name="HotkeySaveResetButton"
                                        Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0"
                                        Margin="8,0,0,0" Click="HotkeySaveReset_Click"
                                        ToolTip="恢复默认快捷键（Ctrl+Alt+S）">
                                    <TextBlock Text="↺" FontFamily="Segoe UI Symbol" FontSize="19"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- data -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="数据" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,4" />

                            <TextBlock Text="单条最大长度（字符）" FontSize="13.5"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,4" />
                            <TextBox x:Name="MaxLengthBox" Style="{StaticResource Input}" Width="220"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="最大长度" TextChanged="MaxLengthBox_TextChanged" />

                            <TextBlock Text="重复内容去重" FontSize="13.5"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,12,0,4" />
                            <ComboBox x:Name="DedupeCombo" Width="220" HorizontalAlignment="Left"
                                      SelectionChanged="SettingsChanged_SelectionChanged">
                                <ComboBoxItem Content="关闭" Tag="0" />
                                <ComboBoxItem Content="5 分钟内" Tag="5" />
                                <ComboBoxItem Content="1 小时内" Tag="60" />
                                <ComboBoxItem Content="24 小时内" Tag="1440" />
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="PauseButton" Style="{StaticResource GhostButton}"
                                        Content="暂停记录 30 分钟" Click="PauseButton_Click" />
                                <TextBlock x:Name="PauseInfo" FontSize="13.5" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,8" />

                            <TextBlock Text="数据目录" FontSize="13.5"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DataDirBox" Style="{StaticResource Input}"
                                         AutomationProperties.Name="数据目录" IsReadOnly="True" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="打开"
                                        Margin="10,0,0,0" Click="OpenDataDir_Click" />
                            </Grid>
                            <TextBlock x:Name="DataStatText" FontSize="13.5" Foreground="{StaticResource TextMuted}"
                                       Margin="0,8,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="导出 JSON"
                                        Margin="0,0,10,8" Click="ExportJson_Click" />
                                <Button Style="{StaticResource GhostButton}" Content="导出 Markdown"
                                        Margin="0,0,10,8" Click="ExportMarkdown_Click" />
                                <Button Style="{StaticResource GhostButton}" Content="导入合并"
                                        Margin="0,0,10,8" Click="Import_Click" />
                                <Button Style="{StaticResource GhostButton}" Content="立即备份"
                                        Margin="0,0,10,8" Click="Backup_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- DeepSeek AI -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="AI识别导入（需配置DEEPSEEK API）" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="API 地址" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,4" />
                            <TextBox x:Name="ApiUrlBox" Style="{StaticResource Input}" FontSize="14"
                                     TextChanged="SettingsChanged_Click" />
                            <TextBlock Text="API Key" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,4" />
                            <TextBox x:Name="ApiKeyBox" Style="{StaticResource Input}" FontSize="14"
                                     TextChanged="SettingsChanged_Click" />
                            <TextBlock Text="模型" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,4" />
                            <TextBox x:Name="ModelBox" Style="{StaticResource Input}" FontSize="14" Width="220"
                                     HorizontalAlignment="Left" TextChanged="SettingsChanged_Click" />

                            <Border x:Name="AdvancedEnableBox" CornerRadius="8" Padding="8,6"
                                    Margin="0,12,0,0" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="0">
                                <CheckBox x:Name="ChkAdvancedEnabled" Content="启用 AI 识别导入"
                                          Checked="SettingsChanged_Click" Unchecked="SettingsChanged_Click" />
                            </Border>
                            <TextBlock x:Name="AdvancedReasonText" FontSize="13" Foreground="#B45309"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="请先在设置中填写 API 地址和 API Key" />
                        </StackPanel>
                    </Border>

                    <!-- about -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="关于" FontSize="16.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="AboutText" FontSize="14" LineHeight="22"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="重新加载数据"
                                        Margin="0,0,10,0" Click="Reload_Click" />
                                <Button Style="{StaticResource GhostButton}" Content="退出 cooopy"
                                        Click="Exit_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- toast -->
            <Border x:Name="ToastBorder" Background="#1F2328" CornerRadius="8" Padding="16,9"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                    Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="14" />
            </Border>
        </Grid>

        <Popup x:Name="FilterPopup" StaysOpen="True" Placement="Bottom" VerticalOffset="2"
               PlacementTarget="{Binding ElementName=FilterButton}" AllowsTransparency="True">
            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,6,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.16" />
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <ScrollViewer MaxHeight="260" Style="{StaticResource ReservedScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FilterPanel" />
                    </ScrollViewer>

                </StackPanel>
            </Border>
        </Popup>

        
    </Grid>
    </Border>
</Window>



