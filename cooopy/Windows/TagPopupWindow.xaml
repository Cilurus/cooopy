<Window x:Class="Cooopy.Windows.TagPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加到 cooopy"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated">

    <Grid Margin="14">
        <!-- shadow layer (kept separate so the text stays crisp) -->
        <Border Background="{StaticResource Surface}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.20" />
            </Border.Effect>
        </Border>

        <!-- content layer -->
        <Border Width="400" Background="{StaticResource Surface}" CornerRadius="12"
                Padding="16,14" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                Padding="12,3" FontSize="13.5" Click="Save_Click" />
                    </StackPanel>
                    <TextBlock Text="添加到 cooopy" FontWeight="SemiBold" FontSize="15.5"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBox x:Name="ContentBox" Style="{StaticResource Input}"
                         MinHeight="40" MaxHeight="76" Margin="0,10,0,0"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Center"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="14" Padding="4,3" />

                <ScrollViewer Style="{StaticResource ReservedScrollViewer}" MaxHeight="168" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="TagPanel" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" Text="还没有标签，可在「标签」页创建"
                           FontSize="13.5" Foreground="{StaticResource TextMuted}"
                           Visibility="Collapsed" Margin="0,4,0,0" />


            </StackPanel>
        </Border>
    </Grid>
</Window>
