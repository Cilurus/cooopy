<Window x:Class="Cooopy.Windows.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#D5D9E0" StrokeThickness="1" />
                            <Ellipse x:Name="Ring" Stroke="{StaticResource Accent}" StrokeThickness="2.2"
                                     Margin="-3" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="{StaticResource Surface}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.20" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource Surface}" CornerRadius="12"
                Padding="20,18" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="新建标签" FontSize="16.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14" />

                <TextBlock Text="标签名称" FontSize="13.5" Foreground="{StaticResource TextSecondary}" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,6,0,0"
                         MaxLength="12" AutomationProperties.Name="标签名称" />

                <TextBlock Text="标签颜色" FontSize="13.5" Foreground="{StaticResource TextSecondary}"
                           Margin="0,14,0,0" />
                <WrapPanel x:Name="SwatchPanel" Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="自定义色值" FontSize="13.5" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="HexBox" Style="{StaticResource Input}" Width="100" Margin="10,0,0,0"
                             MaxLength="7" TextChanged="HexBox_TextChanged"
                             AutomationProperties.Name="颜色值" />
                    <Border x:Name="PreviewDot" Width="24" Height="24" CornerRadius="12" Margin="10,0,0,0"
                            Background="#2F6FEB" BorderBrush="#D5D9E0" BorderThickness="1" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" FontSize="13.5" Foreground="{StaticResource Danger}"
                           Margin="0,8,0,0" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,10,0"
                            Click="Cancel_Click" IsCancel="True" />
                    <Button Style="{StaticResource PrimaryButton}" Content="保存" Click="Save_Click"
                            IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
