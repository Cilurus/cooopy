<Window x:Class="Cooopy.Windows.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cooopy"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="{StaticResource Surface}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.20" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource Surface}" CornerRadius="12"
                Padding="20,18" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="MessageText" FontSize="14.5" Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="取消"
                            Click="Cancel_Click" Margin="0,0,10,0" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}"
                            Content="确定" Click="Confirm_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
